{
  "name": "@tunbudi06/inertia-route-helper",
  "version": "1.3.0",
  "description": "Powerful routing helper for Inertia.js v2 apps with Wayfinder/Ziggy - supports subfolder deployments, query parameters, and route validation",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./init": {
      "import": "./dist/init.js",
      "types": "./dist/init.d.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "laravel",
    "inertia",
    "inertiajs",
    "inertia-js",
    "wayfinder",
    "ziggy",
    "routing",
    "routes",
    "subfolder",
    "typescript",
    "query-parameters",
    "url-helper",
    "spa",
    "ssr"
  ],
  "author": "TUNBudi06",
  "license": "MIT",
  "peerDependencies": {
    "@inertiajs/core": "^2.0.0"
  },
  "devDependencies": {
    "@inertiajs/core": "^2.0.0",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/ui": "^4.0.18",
    "esbuild-plugin-compress": "^1.0.1",
    "happy-dom": "^20.4.0",
    "terser": "^5.46.0",
    "tsup": "^8.0.1",
    "typescript": "^5.3.0",
    "vitest": "^4.0.18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/TUNBudi06/inertia-route-helper.git"
  },
  "bugs": {
    "url": "https://github.com/TUNBudi06/inertia-route-helper/issues"
  },
  "homepage": "https://github.com/TUNBudi06/inertia-route-helper#readme"
}
